{
	"name": "@goobits/forms",
	"version": "4.0.0",
	"description": "Accessible form workflows, validation, submission state, contact handlers, and file uploads for Svelte 5",
	"type": "module",
	"main": "./src/lib/index.ts",
	"types": "./src/lib/index.ts",
	"svelte": "./src/lib/index.ts",
	"publishConfig": {
		"access": "public",
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"svelte": "./dist/index.js",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./ui": {
				"types": "./dist/ui/index.d.ts",
				"svelte": "./dist/ui/index.js",
				"default": "./dist/ui/index.js"
			},
			"./ui/index.css": "./dist/ui/index.css",
			"./ui/form-errors": {
				"types": "./dist/ui/FormErrors.svelte.d.ts",
				"svelte": "./dist/ui/FormErrors.svelte",
				"default": "./dist/ui/FormErrors.svelte"
			},
			"./ui/form-status": {
				"types": "./dist/ui/FormStatus.svelte.d.ts",
				"svelte": "./dist/ui/FormStatus.svelte",
				"default": "./dist/ui/FormStatus.svelte"
			},
			"./core": {
				"types": "./dist/core/index.d.ts",
				"default": "./dist/core/index.js"
			},
			"./sveltekit": {
				"types": "./dist/sveltekit/index.d.ts",
				"default": "./dist/sveltekit/index.js"
			},
			"./config": {
				"types": "./dist/config/index.d.ts",
				"default": "./dist/config/index.js"
			},
			"./validation": {
				"types": "./dist/validation/index.d.ts",
				"default": "./dist/validation/index.js"
			},
			"./i18n": {
				"types": "./dist/i18n/index.d.ts",
				"default": "./dist/i18n/index.js"
			},
			"./services": {
				"types": "./dist/services/index.d.ts",
				"default": "./dist/services/index.js"
			},
			"./handlers": {
				"types": "./dist/handlers/index.d.ts",
				"default": "./dist/handlers/index.js"
			},
			"./handlers/contactFormHandler": {
				"types": "./dist/handlers/contactFormHandler.d.ts",
				"default": "./dist/handlers/contactFormHandler.js"
			},
			"./utils": {
				"types": "./dist/utils/index.d.ts",
				"default": "./dist/utils/index.js"
			}
		}
	},
	"packageManager": "pnpm@11.24.0",
	"scripts": {
		"build": "svelte-package && pnpm run build:clean",
		"build:clean": "find dist -type f -name '*.test.*' -delete",
		"typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.json --config ./svelte.config.js --fail-on-warnings",
		"prepublishOnly": "pnpm run build && pnpm run lint && pnpm run test:unit",
		"test": "pnpm run test:unit",
		"test:unit": "vitest run",
		"test:leaks": "vitest run --detectAsyncLeaks --maxWorkers=1 --silent=passed-only src/lib/ui/ContactForm.a11y.test.ts src/lib/ui/DatePicker.a11y.test.ts",
		"test:heap": "vitest run --logHeapUsage --maxWorkers=1 --reporter=verbose src/lib/handlers/contactFormHandler.test.ts src/lib/ui/ContactForm.a11y.test.ts",
		"test:watch": "vitest --watch",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:a11y": "vitest run --reporter=verbose src/lib/ui/**/*.a11y.test.ts",
		"test:a11y:watch": "vitest --reporter=verbose src/lib/ui/**/*.a11y.test.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"test:e2e:codegen": "playwright codegen http://localhost:3180",
		"test:e2e:report": "playwright show-report",
		"validate:docs": "node tests/docs-validator.js",
		"validate": "pnpm run validate:docs",
		"lint": "eslint . --ext .js,.ts,.svelte",
		"format": "prettier --write .",
		"demo": "cd demo && pnpm run dev",
		"demo:build": "cd demo && pnpm run build",
		"demo:preview": "cd demo && pnpm run preview"
	},
	"exports": {
		".": {
			"types": "./src/lib/index.ts",
			"svelte": "./src/lib/index.ts",
			"default": "./src/lib/index.ts"
		},
		"./ui": {
			"types": "./src/lib/ui/index.ts",
			"svelte": "./src/lib/ui/index.ts",
			"default": "./src/lib/ui/index.ts"
		},
		"./ui/index.css": "./src/lib/ui/index.css",
		"./ui/form-errors": {
			"types": "./src/lib/ui/FormErrors.svelte",
			"svelte": "./src/lib/ui/FormErrors.svelte",
			"default": "./src/lib/ui/FormErrors.svelte"
		},
		"./ui/form-status": {
			"types": "./src/lib/ui/FormStatus.svelte",
			"svelte": "./src/lib/ui/FormStatus.svelte",
			"default": "./src/lib/ui/FormStatus.svelte"
		},
		"./core": {
			"types": "./src/lib/core/index.ts",
			"default": "./src/lib/core/index.ts"
		},
		"./sveltekit": {
			"types": "./src/lib/sveltekit/index.ts",
			"default": "./src/lib/sveltekit/index.ts"
		},
		"./config": {
			"types": "./src/lib/config/index.ts",
			"default": "./src/lib/config/index.ts"
		},
		"./validation": {
			"types": "./src/lib/validation/index.ts",
			"default": "./src/lib/validation/index.ts"
		},
		"./i18n": {
			"types": "./src/lib/i18n/index.ts",
			"default": "./src/lib/i18n/index.ts"
		},
		"./services": {
			"types": "./src/lib/services/index.ts",
			"default": "./src/lib/services/index.ts"
		},
		"./handlers": {
			"types": "./src/lib/handlers/index.ts",
			"default": "./src/lib/handlers/index.ts"
		},
		"./handlers/contactFormHandler": {
			"types": "./src/lib/handlers/contactFormHandler.ts",
			"default": "./src/lib/handlers/contactFormHandler.ts"
		},
		"./utils": {
			"types": "./src/lib/utils/index.ts",
			"default": "./src/lib/utils/index.ts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"dependencies": {
		"@goobits/goo": "workspace:*",
		"@goobits/logger": "workspace:*",
		"@goobits/security": "workspace:*",
		"@lucide/svelte": "^1.33.0",
		"formsnap": "^2.0.1",
		"sveltekit-superforms": "^2.30.2",
		"zod": "^4.4.3"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.70.3",
		"svelte": "^5.56.10"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"forms",
		"form",
		"contact-form",
		"validation",
		"recaptcha",
		"i18n",
		"internationalization",
		"form-builder",
		"form-components",
		"rate-limiting"
	],
	"license": "MIT",
	"author": "GooBits",
	"homepage": "https://github.com/goobits/forms#readme",
	"bugs": {
		"url": "https://github.com/goobits/forms/issues"
	},
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=9.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/goobits/forms.git"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.6",
		"@types/node": "^26.2.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"axe-core": "^4.13.0",
		"eslint": "^10.9.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jest-axe": "^11.0.0",
		"jsdom": "^30.0.1",
		"msw": "^2.15.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
